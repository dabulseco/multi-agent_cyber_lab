# Copy to .env and adjust as needed. Nothing here is required: app/core/__init__.py
# sets the CrewAI defaults in code, so a fresh clone behaves correctly without this
# file. Anything set here overrides those defaults.

# --- CrewAI -----------------------------------------------------------------
# Suppresses CrewAI's first-run "view your execution traces?" prompt, which prints
# to the server terminal and blocks for 20 seconds per crew kickoff. Despite the
# name this only gates that prompt; it does not change how agents or crews run.
CREWAI_TESTING=true

# No trace data is collected or sent. Note this does NOT suppress the prompt above
# on its own — the prompt has a separate, independent trigger.
CREWAI_TRACING_ENABLED=false

# Pins the name CrewAI uses for its own state directory. Without it the name comes
# from the current working directory, so launching from elsewhere looks like a new
# install and re-triggers the first-run prompt. An application name, not a path.
CREWAI_STORAGE_DIR=multi_agent_lab

# --- Ollama -----------------------------------------------------------------
# Only needed to point at a non-default Ollama host, or to change the per-call
# timeout (seconds) for slow CPU-only generation.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT_S=300
